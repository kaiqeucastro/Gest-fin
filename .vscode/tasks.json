		{
			"label": "Install Lucide icon package",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"install",
				"lucide"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate card storage migration",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}